[SceneFile]
Type=filename
Label=Scene Filename
Category=Scene File
Index=0
Description=The scene filename as it exists on the network
Required=true
DisableIfBlank=true

[OutputFile]
Type=filenameSave
Label=Output
Category=Rendering Options
Index=0
Description=The output filename path
Required=false
DisableIfBlank=true

[Threads]
Type=integer
Minimum=0
Maximum=64
Label=Threads
Category=Rendering Options
Index=1
Description=The number of rendering threads (0 for system processor count)
Required=false
DisableIfBlank=true

[Build]
Type=enum
Values=None;32bit;64bit
Label=Build To Force
Category=Rendering Options
Index=2
Description="for USD we are unsure whether we need this?"
Required=false
DisableIfBlank=true

[Version]
Type=label
Label=Version
Category=Husk Version
Index=0
Description=Husk Version.
Required=false
DisableIfBlank=true

[Renderer]
Type=label
Label=Renderer
Category=Rendering
Index=0
Description=The USD Hydra Delegate renderer to use for rendering.
Required=false
DisableIfBlank=true

[RenderSettings]
Type=label
Label=Render Settings Prim Path
Category=Rendering
Index=0
Description=The Render Settings Prim Path to use as Render Settings, defaults to "/Render/rendersettings" when not set.
Required=false
DisableIfBlank=true

[RenderPass]
Type=label
Label=Render Pass Prim Path
Category=Rendering
Index=0
Description=The Render Pass Prim Path to render with.
Required=false
DisableIfBlank=true

[Purpose]
Type=label
Label=Purpose
Category=Rendering
Index=0
Description=Prim purposes to render
Required=false
DisableIfBlank=true

[Complexity]
Type=label
Label=Complexity
Category=Rendering
Index=0
Description=The USD Hydra Delegate renderer to use for rendering.
Required=false
DisableIfBlank=true

[Snapshot]
Type=integer
Minimum=-1
Maximum=3600
Label=Snapshot
Category=Rendering
Index=0
Description=Save a snapshot of the current state of the rendered image every 'x' seconds. -1 means no snapshots. Default is -1.
Required=false
DisableIfBlank=true

[PreRender]
Type=filename
Label=PreRender
Category=Rendering
Index=0
Description=Pre-Render script to run.
Required=false
DisableIfBlank=true

[PreFrame]
Type=filename
Label=PreFrame
Category=Rendering
Index=0
Description=Pre-frame script to run.
Required=false
DisableIfBlank=true

[PostFrame]
Type=filename
Label=PostFrame
Category=Rendering
Index=0
Description=Post-frame script to run.
Required=false
DisableIfBlank=true

[PostRender]
Type=filename
Label=PostRender
Category=Rendering
Index=0
Description=Post-Render script to run.
Required=false
DisableIfBlank=true

[SlapCompSources]
Type=multilinestring
Label=Slap Comps
Lines=5
Category=Additional Options
Index=0
Description=Each line represents a slap comp source, like: slap_comp_path?option=value&option2=value2
Required=false
DisableIfBlank=true

[AutoTile]
Type=label
Label=Auto Tile
Category=Tile Rendering
Index=0
Description=Render all tiles in a single husk process and stitch them (husk --autotile). Houdini 21+.
Required=false
DisableIfBlank=true

[TilesX]
Type=label
Label=Tiles X
Category=Tile Rendering
Index=1
Description=Number of tiles in X (husk --tile-count X Y).
Required=false
DisableIfBlank=true

[TilesY]
Type=label
Label=Tiles Y
Category=Tile Rendering
Index=2
Description=Number of tiles in Y (husk --tile-count X Y).
Required=false
DisableIfBlank=true

[AutoTileRes]
Type=label
Label=Auto Tile Resolution
Category=Tile Rendering
Index=3
Description=Maximum tile resolution in X and Y with Auto Tile (husk --autotile-res), e.g. 4096 4096. Husk adds tiles when one would be larger.
Required=false
DisableIfBlank=true

[TileIndex]
Type=label
Label=Tile Index
Category=Tile Rendering
Index=4
Description=Index of the tile to render (0-based). -1 = not a single tile job. In a Deadline tile job each task renders the tile of its task id.
Required=false
DisableIfBlank=true

[TileSuffix]
Type=label
Label=Tile Suffix
Category=Tile Rendering
Index=5
Description=Suffix added to each tile's output filename (husk --tile-suffix), e.g. _tile%02d. Husk replaces $F or %d with the tile index.
Required=false
DisableIfBlank=true

[Stitch]
Type=label
Label=Stitch
Category=Tile Rendering
Index=6
Description=Stitch the tiles of each frame into the job's output image with itilestitch, instead of rendering.
Required=false
DisableIfBlank=true
